{
    "owner_agent": "Security Patch Management Agent",
    "tasks": {
        "Phishing Detection": "Using AI models to detect phishing attempts on the website.",
        "Security Patch Application": "Applying security patches and updates to fix vulnerabilities identified by monitoring tools.",
        "User Education": "Educating users about common phishing tactics and how to avoid them.",
        "Website Monitoring": "Monitoring the website for any suspicious activities or unauthorized access attempts."
    },
    "orders": [
        {
            "condition": "suspicious_activity",
            "from": "Website Monitoring",
            "to": "Phishing Detection"
        },
        {
            "condition": "vulnerability_detected",
            "from": "Website Monitoring",
            "to": "Security Patch Application"
        },
        {
            "condition": "phishing_attempt_detected",
            "from": "Phishing Detection",
            "to": "User Education"
        },
        {
            "condition": "no_phishing",
            "from": "Phishing Detection",
            "to": "Security Patch Application"
        },
        {
            "condition": "patch_applied",
            "from": "Security Patch Application",
            "to": "End"
        },
        {
            "condition": "education_completed",
            "from": "User Education",
            "to": "End"
        }
    ]
}