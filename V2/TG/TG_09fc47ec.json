            "from": "Phishing Detection",
            "to": "Security Patching"
        },
        {
            "condition": "vulnerabilities_found",
            "from": "Vulnerability Assessment",
            "to": "Security Patching"
        },
        {
            "condition": "patched",
            "from": "Security Patching",
            "to": "End"
        },
        {
            "condition": "phishing_detected",
            "from": "Phishing Detection",
            "to": "User Education"
        },
        {
            "condition": "vulnerabilities_found",
            "from": "Vulnerability Assessment",
            "to": "User Education"
        },
        {
